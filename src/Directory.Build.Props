<Project>
  <!-- Project properties -->
  <PropertyGroup>
    <Copyright>Copyright © 2013 - $([System.DateTime]::Today.ToString(yyyy)) LoadingIndicators.WPF</Copyright>
    <Description>A collection of 8 animated loading indicators for WPF.</Description>

    <TargetFrameworks>net45;net6.0-windows</TargetFrameworks>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <LangVersion>latest</LangVersion>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>pdbonly</DebugType>
    <NoWarn>1591</NoWarn>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <DebugType>portable</DebugType>
    <PackageProjectUrl>https://github.com/LTRData/SemanticTypes</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>$(LocalNuGetPath)</PackageOutputPath>
    <PackageId>LTRData.$(MSBuildProjectName)</PackageId>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Version>2.0.1</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <Company>LTR Data</Company>
    <Product>LTRData.$(MSBuildProjectName)</Product>
    <ProductName>LTRData.$(MSBuildProjectName)</ProductName>
    <Authors>Olof Lagerkvist, mperdeck</Authors>
    <PackageVersion>$(Version)</PackageVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="**\*.png;**\*.jpg;**\*.ico"/>
    <Resource Include="**\*.png;**\*.jpg;**\*.ico"/>
  </ItemGroup>

</Project>
